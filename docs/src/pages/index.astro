---
import '../styles/landing.css'

import BuiltOn from '../components/landing/BuiltOn.astro'
import Bento from '../components/landing/Bento.astro'
import Contracts from '../components/landing/Contracts.astro'
import Cta from '../components/landing/Cta.astro'
import Deploy from '../components/landing/Deploy.astro'
import Footer from '../components/landing/Footer.astro'
import Hero from '../components/landing/Hero.astro'
import HowItWorks from '../components/landing/HowItWorks.astro'
import Minute from '../components/landing/Minute.astro'
import Nav from '../components/landing/Nav.astro'

const title = 'Holtkeeper — keep every repository in shape'
const description =
  'Self-hosted automation engine for fleets of GitLab and GitHub repositories: AI code review with one-click suggestions, dependency waves that fix breaking changes, audits and releases, built on contracts you can swap.'
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      ;(() => {
        const root = document.documentElement
        root.dataset.js = ''
        let stored = null
        try {
          stored = localStorage.getItem('starlight-theme')
        } catch {}
        const system = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
        root.dataset.theme = stored === 'light' || stored === 'dark' ? stored : stored === '' ? system : 'dark'
      })()
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <meta name="theme-color" content="#0a0907" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL('/', Astro.site)} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="l-page">
    <Nav />
    <main>
      <Hero />
      <HowItWorks />
      <Minute />
      <Bento />
      <Contracts />
      <Deploy />
      <BuiltOn />
      <Cta />
    </main>
    <Footer />
    <script>
      const root = document.documentElement
      const mark = () => root.toggleAttribute('data-scrolled', window.scrollY > 8)
      mark()
      addEventListener('scroll', mark, { passive: true })

      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            entry.target.setAttribute('data-shown', '')
            reveal.unobserve(entry.target)
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      )
      document.querySelectorAll('.l-reveal').forEach((el) => reveal.observe(el))

      for (const card of document.querySelectorAll<HTMLElement>('.l-card')) {
        card.addEventListener('pointermove', (e) => {
          const box = card.getBoundingClientRect()
          card.style.setProperty('--x', `${e.clientX - box.left}px`)
          card.style.setProperty('--y', `${e.clientY - box.top}px`)
        })
      }

      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          const text = button.dataset.copy ?? ''
          try {
            await navigator.clipboard.writeText(text)
          } catch {
            return
          }
          button.dataset.copied = ''
          setTimeout(() => delete button.dataset.copied, 1600)
        })
      }
    </script>
  </body>
</html>
