---
const tools = [
  { name: 'Bun', what: 'runtime, tests, SQLite' },
  { name: 'TypeScript 7', what: 'native type checking' },
  { name: 'oxlint · oxfmt', what: 'lint and format' },
  { name: 'Hono', what: 'HTTP API' },
  { name: 'PostgreSQL', what: 'store for the server' },
  { name: 'HeroUI', what: 'admin panel' },
  { name: 'Claude Agent SDK', what: 'agents on a checkout' },
  { name: 'ast-grep', what: 'conventions, tracking' },
  { name: 'OSV-Scanner', what: 'vulnerabilities' },
  { name: 'gitleaks', what: 'leaked secrets' },
  { name: 'Renovate', what: 'dependency updates' },
  { name: 'knip', what: 'dead code' },
  { name: 'jscpd', what: 'copy-paste detection' },
  { name: 'sharp', what: 'AVIF and WebP' },
  { name: 'SVGO', what: 'SVG optimization' },
  { name: 'mise', what: 'toolchains per repository' },
]
---

<section class="built" aria-label="Built on">
  <div class="l-wrap">
    <p class="label">Built on tools that already do one thing well</p>
  </div>
  <div class="marquee">
    <ul class="track">
      {
        [...tools, ...tools].map((t, i) => (
          <li aria-hidden={i >= tools.length ? 'true' : undefined}>
            <b>{t.name}</b>
            <span>{t.what}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .built {
    padding-block: 3.5rem;
    border-block: 1px solid var(--l-line);
    background: var(--l-bg-2);
  }
  .label {
    margin-bottom: 1.75rem;
    color: var(--l-dim);
    font: 0.75rem var(--l-mono);
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
  }
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    gap: 3rem;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: scroll 64s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  li {
    display: grid;
    gap: 0.15rem;
  }
  b {
    color: var(--l-text);
    font-size: 1.3rem;
    font-weight: 640;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  span {
    color: var(--l-dim);
    font: 0.72rem var(--l-mono);
    white-space: nowrap;
  }
  @keyframes scroll {
    to {
      transform: translateX(calc(-50% - 1.5rem));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }
    .track {
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      padding-inline: 1.5rem;
    }
    li[aria-hidden] {
      display: none;
    }
  }
</style>
