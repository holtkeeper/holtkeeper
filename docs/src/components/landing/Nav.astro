---
import { Icon } from '@astrojs/starlight/components'

import Logo from '@holtkeeper/brand/holtkeeper.svg'
---

<header class="l-nav">
  <div class="l-wrap l-nav-bar">
    <a class="l-brand" href="/" aria-label="Holtkeeper home">
      <Logo width={28} height={28} aria-hidden="true" />
      <span>Holtkeeper</span>
    </a>
    <nav class="l-links" aria-label="Main">
      <a href="/start/">Start</a>
      <a href="/guide/">Guide</a>
      <a href="/agents/">Agents</a>
      <a href="/self-host/">Self-host</a>
      <a href="/develop/">Develop</a>
      <a href="/reference/">Reference</a>
    </nav>
    <span class="l-sp"></span>
    <a class="l-btn ghost" href="https://github.com/holtkeeper/holtkeeper" aria-label="Holtkeeper on GitHub">
      <Icon name="github" size="1rem" />
      <span class="l-hide-sm">GitHub</span>
    </a>
    <button class="l-btn ghost icon" type="button" data-theme-toggle aria-label="Switch color theme">
      <Icon name="sun" size="1rem" class="l-sun" />
      <Icon name="moon" size="1rem" class="l-moon" />
    </button>
    <a class="l-btn primary" href="/start/quickstart/">Get started</a>
  </div>
</header>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const root = document.documentElement
      const next = root.dataset.theme === 'light' ? 'dark' : 'light'
      root.dataset.theme = next
      try {
        localStorage.setItem('starlight-theme', next)
      } catch {}
    })
  }
</script>
