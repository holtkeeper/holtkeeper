---
import Tour from './Tour.astro'

const command = 'docker compose up -d --scale worker=3'
---

<section class="l-hero">
  <div class="l-wrap l-hero-grid">
    <div class="l-hero-copy">
      <div class="l-tags">
        <span class="hk-tag">Self-hosted</span>
        <span class="hk-tag">GitLab</span>
        <span class="hk-tag">GitHub · soon</span>
      </div>
      <div class="l-hero-title">
        <h1>A cozy holt for every repository.</h1>
        <p class="l-hero-sub">From one homelab box to a production zoo of stacks.</p>
      </div>
      <p class="l-lede">
        Monorepos next to polyrepos, pnpm next to Go, changesets next to hand-made tags: Holtkeeper
        reviews merge requests, ships dependency upgrades that fix their own breaking changes, audits
        security and licenses, and runs releases across all of it. People work in the panel. Agents use
        the same data over MCP.
      </p>
      <div class="l-row">
        <a class="l-btn primary lg" href="/start/">Read the docs →</a>
        <a class="l-btn lg" href="/start/quickstart/">Deploy in 5 minutes</a>
      </div>
      <div class="l-cmd">
        <code><span aria-hidden="true">$ </span>{command}</code>
        <button class="l-btn ghost icon" type="button" data-copy={command} aria-label="Copy command">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="8" y="8" width="12" height="12" rx="2"></rect>
            <path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"></path>
          </svg>
        </button>
      </div>
    </div>
    <Tour />
  </div>
</section>
