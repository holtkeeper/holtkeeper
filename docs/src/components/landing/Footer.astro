---
import Logo from '@holtkeeper/brand/holtkeeper.svg'

const columns = [
  ['Start', [['Overview', '/start/'], ['Quickstart', '/start/quickstart/'], ['Concepts', '/start/concepts/fleet/'], ['First steps', '/start/first-steps/connect-forge/']]],
  ['Guide', [['Home & Inbox', '/guide/home/overview/'], ['Repos', '/guide/repos/repositories/'], ['Supply chain', '/guide/supply-chain/libraries/'], ['Quality', '/guide/quality/coverage/'], ['Releases', '/guide/releases/overview/']]],
  ['Agents', [['Connect an agent', '/agents/connect/'], ['MCP tools', '/reference/mcp-tools/'], ['Tasks', '/agents/tasks/'], ['Review agent', '/agents/review-agent/']]],
  ['Self-host', [['Single container', '/self-host/run/single-container/'], ['Kubernetes', '/self-host/run/kubernetes/'], ['Configuration', '/self-host/configure/configuration/'], ['Upgrades', '/self-host/operate/upgrades/']]],
  ['Develop', [['Architecture', '/develop/architecture/'], ['Setup', '/develop/setup/'], ['Modules', '/modules/'], ['Plan', '/develop/plan/']]],
] as const
---

<footer class="l-foot">
  <div class="l-wrap">
    <div class="l-fgrid">
      <div class="l-fcol l-fbrand">
        <a class="l-brand" href="/"><Logo width={26} height={26} aria-hidden="true" /><span>Holtkeeper</span></a>
        <span class="hk-mut">A cozy holt for every repository, from a homelab to a production zoo.</span>
      </div>
      {
        columns.map(([title, links]) => (
          <nav class="l-fcol" aria-label={title}>
            <b>{title}</b>
            {links.map(([label, href]) => (
              <a href={href}>{label}</a>
            ))}
          </nav>
        ))
      }
    </div>
    <div class="l-fbot">
      <span>MIT licensed</span>
      <span class="l-sp"></span>
      <a href="https://github.com/holtkeeper/holtkeeper">GitHub</a>
    </div>
  </div>
</footer>
