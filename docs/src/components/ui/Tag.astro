---
interface Props {
  tone?: 'ok' | 'warn' | 'bad' | 'info' | 'acc'
  mono?: boolean
  icon?: 'panel'
}

const { tone, mono = false, icon } = Astro.props
---

<span class:list={['hk-tag', tone, { 'hk-mono': mono }]}>
  {
    icon === 'panel' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M3 9h18" />
      </svg>
    )
  }
  <slot />
</span>
