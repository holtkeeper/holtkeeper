---
import Search from 'virtual:starlight/components/Search'
import SiteTitle from 'virtual:starlight/components/SiteTitle'
import SocialIcons from 'virtual:starlight/components/SocialIcons'
import ThemeSelect from 'virtual:starlight/components/ThemeSelect'

const topics = Astro.locals.starlightSidebarTopics?.topics ?? []
---

<div class="hk-header">
  <div class="hk-header-top">
    <div class="hk-header-title">
      <SiteTitle />
      <span class="hk-header-slash" aria-hidden="true">/</span>
      <span class="hk-header-docs">Docs</span>
    </div>
    <div class="hk-header-search print:hidden">
      <Search />
    </div>
    <div class="sl-hidden md:sl-flex print:hidden hk-header-right">
      <SocialIcons />
      <ThemeSelect />
    </div>
  </div>
  <nav class="hk-tabs print:hidden" aria-label="Documentation sections">
    {
      topics.map((t) => (
        <a href={t.link} aria-current={t.isCurrent ? 'page' : undefined}>
          {t.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .hk-header {
    display: grid;
    grid-template-rows: var(--hk-top-row) 1fr;
    height: 100%;
  }

  .hk-header-top {
    display: flex;
    gap: var(--sl-nav-gap);
    align-items: center;
    min-width: 0;
  }

  .hk-header-title {
    display: flex;
    flex: none;
    gap: 0.6rem;
    align-items: center;
    min-width: 0;
  }

  .hk-header-slash {
    color: var(--hk-line2);
    font-size: 1.2rem;
    font-weight: 300;
  }

  .hk-header-docs {
    color: var(--hk-mut);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .hk-header-search {
    display: flex;
    flex: 1;
    justify-content: flex-end;
    min-width: 0;
  }

  .hk-header-right {
    gap: 0.75rem;
    align-items: center;
  }

  .hk-tabs {
    display: flex;
    gap: 1.25rem;
    align-items: stretch;
    margin-inline: calc(var(--sl-nav-pad-x) * -1);
    padding-inline: var(--sl-nav-pad-x);
    overflow-x: auto;
    border-top: 1px solid var(--hk-line);
    scrollbar-width: none;
  }

  .hk-tabs a {
    display: inline-flex;
    flex: none;
    align-items: center;
    margin-bottom: -1px;
    border-bottom: 1.5px solid transparent;
    color: var(--hk-mut);
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
  }

  .hk-tabs a:hover {
    color: var(--sl-color-white);
  }

  .hk-tabs a[aria-current='page'] {
    border-bottom-color: var(--hk-acc);
    color: var(--sl-color-white);
  }

  @media (min-width: 50rem) {
    .hk-header-search {
      justify-content: center;
    }

    .hk-header-search :global(site-search) {
      width: min(26rem, 100%);
    }
  }
</style>
