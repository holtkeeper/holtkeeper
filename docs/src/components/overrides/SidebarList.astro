---
import { Badge, Icon } from '@astrojs/starlight/components'
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro'

type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number]
type IconName = Parameters<typeof Icon>[0]['name']

interface Props {
  entries: Entry[]
  icons?: Record<string, IconName>
  nested?: boolean
}

const { entries, icons = {}, nested = false } = Astro.props
const hasCurrent = (e: Entry): boolean => (e.type === 'link' ? e.isCurrent : e.entries.some(hasCurrent))
---

<ul class:list={['hk-nav', { 'hk-nav-nested': nested }]}>
  {
    entries.map((e) => (
      <li>
        {e.type === 'link' ? (
          <a href={e.href} aria-current={e.isCurrent ? 'page' : undefined} {...e.attrs}>
            <span>{e.label}</span>
            {e.badge && <Badge variant={e.badge.variant} text={e.badge.text} />}
          </a>
        ) : (
          <details open={hasCurrent(e) || !e.collapsed}>
            <summary class:list={{ 'hk-has-current': hasCurrent(e) }}>
              {icons[e.label] && <Icon name={icons[e.label]!} class="hk-nav-icon" />}
              <span>{e.label}</span>
              <span class="hk-count">{e.entries.length}</span>
              <Icon name="right-caret" class="hk-caret" />
            </summary>
            <SidebarRestorePoint />
            <Astro.self entries={e.entries} nested />
          </details>
        )}
      </li>
    ))
  }
</ul>
