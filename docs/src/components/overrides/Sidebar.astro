---
import { Icon } from '@astrojs/starlight/components'
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro'
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro'

import { moduleGroups } from '../../docs/groups.ts'
import SidebarList from './SidebarList.astro'

type IconName = Parameters<typeof Icon>[0]['name']

const { sidebar } = Astro.locals.starlightRoute
const topics = Astro.locals.starlightSidebarTopics?.topics ?? []
const icons: IconName[] = ['open-book', 'puzzle']
const groupIcons = Object.fromEntries(moduleGroups.map((g) => [g.label, g.icon as IconName]))
---

<ul class="hk-topics">
  {
    topics.map((t, i) => (
      <li>
        <a href={t.link} aria-current={t.isCurrent ? 'page' : undefined}>
          <span class="hk-topic-icon">
            <Icon name={icons[i] ?? 'document'} />
          </span>
          {t.label}
        </a>
      </li>
    ))
  }
  <li>
    <a href="https://github.com/holtkeeper/holtkeeper" rel="noopener">
      <span class="hk-topic-icon"><Icon name="github" /></span>
      GitHub
    </a>
  </li>
</ul>

<SidebarPersister>
  <SidebarList entries={sidebar} icons={groupIcons} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
