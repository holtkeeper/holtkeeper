---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro'
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro'

import SidebarList from './SidebarList.astro'

const { sidebar } = Astro.locals.starlightRoute
const topics = Astro.locals.starlightSidebarTopics?.topics ?? []
---

<nav class="hk-mobile-topics md:sl-hidden" aria-label="Documentation sections">
  {
    topics.map((t) => (
      <a href={t.link} aria-current={t.isCurrent ? 'page' : undefined}>
        {t.label}
      </a>
    ))
  }
</nav>

<SidebarPersister>
  <SidebarList entries={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .hk-mobile-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--hk-line);
  }

  .hk-mobile-topics a {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--hk-line);
    border-radius: 0.45rem;
    color: var(--hk-mut);
    font-size: 0.84rem;
    text-decoration: none;
  }

  .hk-mobile-topics a[aria-current='page'] {
    border-color: var(--hk-line2);
    background: var(--hk-panel);
    color: var(--sl-color-white);
  }
</style>
