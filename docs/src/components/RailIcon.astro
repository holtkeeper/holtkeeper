---
import { railIcons, type RailIconName } from './rail-icons.ts'

interface Props {
  name: RailIconName
  class?: string
}

const { name, class: className } = Astro.props
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {railIcons[name].map((d) => <path d={d} />)}
</svg>
