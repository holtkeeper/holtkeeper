# Copy to .env next to docker-compose.yml. Never commit the filled-in file.
POSTGRES_PASSWORD=change-me
# Artifacts: any S3-compatible storage (AWS, R2, Garage, MinIO, Ceph, VersityGW…).
# Leave S3_ENDPOINT unset to use the bundled VersityGW (`--profile local-s3`).
# S3_ENDPOINT=https://s3.example.com
S3_BUCKET=holtkeeper
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=holtkeeper
S3_SECRET_ACCESS_KEY=change-me
HOLTKEEPER_ROOT_PASSWORD=change-me
# At least 32 characters each, e.g. `openssl rand -hex 32`.
HOLTKEEPER_SESSION_SECRET=
HOLTKEEPER_VAULT_KEY=
HOLTKEEPER_WEBHOOK_SECRET=
# HOLTKEEPER_PUBLIC_URL=https://holtkeeper.example.com
# Set to 1 only for plain-HTTP local tests.
# HOLTKEEPER_INSECURE_COOKIES=1
# GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=
