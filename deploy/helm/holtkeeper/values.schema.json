{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Holtkeeper chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": ["repository"]
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string",
          "description": "holtkeeper.config.ts; empty uses the chart's default"
        },
        "existingConfigMap": {
          "type": "string"
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "description": "Secret exposed to every container as environment variables"
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "tmpSizeLimit": {
      "type": ["string", "integer"]
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["host", "paths"]
              }
            },
            "tls": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "hpa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": ["integer", "string"]
            }
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "maxJobs": {
          "type": "integer",
          "minimum": 0
        },
        "drainTimeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m)?$"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sizeLimit": {
              "type": ["string", "integer"]
            }
          }
        },
        "miseCache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["emptyDir", "pvc"]
            },
            "sizeLimit": {
              "type": ["string", "integer"]
            },
            "size": {
              "type": ["string", "integer"]
            },
            "storageClassName": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "existingClaim": {
              "type": "string"
            }
          }
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": ["integer", "string"]
            }
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": ["integer", "string"]
            }
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "keda": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serverAddress": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "threshold": {
          "type": ["string", "integer"]
        },
        "minReplicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxReplicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "pollingInterval": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownPeriod": {
          "type": "integer",
          "minimum": 0
        },
        "scaledJob": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxReplicaCount": {
              "type": "integer",
              "minimum": 1
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "webIngressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricsFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "workerEgress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "extraEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": ["image", "port", "config", "web", "worker", "scheduler"]
}
