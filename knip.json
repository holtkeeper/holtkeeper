{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    ".": {
      "entry": ["deploy/holtkeeper.config.ts", "deploy/helm/*/files/*.ts"]
    },
    "docs": {
      "ignoreDependencies": [
        "@astrojs/check",
        "@fontsource-variable/geist",
        "@fontsource-variable/geist-mono"
      ]
    },
    "examples": {
      "entry": ["dev/*.ts"]
    }
  }
}
