{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "bun.lock",
    "fixtures/**/*.json",
    "fixtures/**/*.yaml",
    "deploy/helm/*/templates/**"
  ]
}
